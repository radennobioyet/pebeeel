# Salin file ini menjadi .env dan sesuaikan nilainya
# Jangan pernah commit file .env ke repository!

DB_HOST=localhost
DB_PORT=5432
DB_NAME=snaprent_db
DB_USER=postgres
DB_PASS=password_anda

# Base URL aplikasi (akhiri TANPA slash)
# Untuk php -S localhost:8000 (dari folder root project):
APP_URL=http://localhost:8000
